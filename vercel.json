{
  "version": 2,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    },
    {
      "src": "*.png",
      "use": "@vercel/static"
    },
    {
      "src": "api/usercount.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/userstats.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/usercount",
      "dest": "/api/usercount.js"
    },
    {
      "src": "/api/userstats",
      "dest": "/api/userstats.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
